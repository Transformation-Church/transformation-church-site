# ---------------------------------------------------------------- Sanity
# The blog reads from Sanity when these are set, and falls back to the posts
# migrated out of WordPress when they are not.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------- Forms
# Contact and newsletter submissions are emailed via Resend (resend.com).
# CONTACT_FROM must be an address on a domain verified in your Resend account.
RESEND_API_KEY=
CONTACT_FROM="Transformation Church <website@bpfministries.com>"
# Optional: overrides the default recipient (info@bpfministries.com).
CONTACT_TO=

# ---------------------------------------------------------------- Instagram
# A Behold.so feed URL, or your own endpoint wrapping the Instagram Graph API.
# Leave empty to show a follow panel instead of a grid.
INSTAGRAM_FEED_URL=

# ---------------------------------------------------------------- Launch
# Set to "true" only once the site is live on its own domain. Until then the
# site sends noindex headers so the .vercel.app URL is not indexed as
# duplicate content against the old WordPress site.
SITE_INDEXABLE=
